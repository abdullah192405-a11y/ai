{
  "name": "wba-platform",
  "private": true,
  "description": "AI Website Assistant Platform — monorepo",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node services/platform-api/index.js",
    "build": "npm run build -w @wba/user && rm -rf dist && cp -r apps/user/dist dist",
    "build:user": "npm run build -w @wba/user && rm -rf dist && cp -r apps/user/dist dist",
    "build:admin": "npm run build -w @wba/admin && rm -rf dist && cp -r apps/admin/dist dist",
    "build:website": "npm run build -w @wba/website && rm -rf dist && cp -r apps/website/dist dist",
    "build:widget": "npm run build -w @wba/widget && cp apps/widget/dist/widget.iife.js services/platform-api/public/widget.iife.js",
    "dev": "concurrently -n api,user,admin,website -c blue,green,magenta,cyan \"npm:dev:api\" \"npm:dev:user\" \"npm:dev:admin\" \"npm:dev:website\"",
    "dev:admin": "npm run dev -w @wba/admin",
    "dev:superadmin": "npm run dev -w @wba/admin",
    "dev:user": "npm run dev -w @wba/user",
    "dev:website": "npm run dev -w @wba/website",
    "dev:widget": "npm run dev -w @wba/widget",
    "dev:api": "npm run dev -w @wba/platform-api",
    "docker:up": "docker compose up -d",
    "docker:services": "docker compose --profile services up -d",
    "docker:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @wba/platform-api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.27.3",
    "@rollup/rollup-linux-x64-gnu": "^4.34.8",
    "@rollup/rollup-linux-x64-musl": "^4.34.8"
  },
  "engines": {
    "node": ">=20"
  }
}
