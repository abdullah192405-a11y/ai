# ─── Server ───────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ─── Database (PostgreSQL) ────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wba_platform
DB_USER=wba_admin
DB_PASSWORD=change_me_in_production

# ─── Redis ────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ──────────────────────────────────────
JWT_ACCESS_SECRET=change_me_use_rsa_key_in_production
JWT_REFRESH_SECRET=change_me_use_different_key
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=wba-auth

# ─── API Key ─────────────────────────────────
API_KEY_PREFIX=wba_live_
API_KEY_CACHE_TTL=300

# ─── Logging ─────────────────────────────────
LOG_LEVEL=debug

# ─── CORS ────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
