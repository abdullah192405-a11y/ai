# ─────────────────────────────────────────────────────────────────
# NABEEH Platform API — Production Environment Variables
# Copy this file to .env and fill in the values on Render.com
# ─────────────────────────────────────────────────────────────────

# ─── Server ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080

# Your Render service URL (e.g. https://nabeeh-api.onrender.com)
PUBLIC_BASE_URL=https://YOUR_SERVICE.onrender.com

# ─── Database (get from Neon.tech → Connection String) ───────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Auth ────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX

# ─── AI (use at least one) ───────────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=

# auto = uses Groq if GROQ_API_KEY is set, otherwise Gemini
AI_PROVIDER=auto
DEFAULT_MODEL=gemini-2.5-flash-lite

# ─── Platform Admin (first superadmin account) ───────────────────
ADMIN_EMAIL=admin@nabeeh.ai
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ─── CORS: URLs of your Vercel deployed frontends ────────────────
USER_DASHBOARD_URL=https://YOUR_USER_APP.vercel.app
ADMIN_DASHBOARD_URL=https://YOUR_ADMIN_APP.vercel.app
