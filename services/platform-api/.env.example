# ─── WBA MVP backend environment ───────────────────────────
# Copy to .env and fill in values:  cp .env.example .env

# HTTP port the API + widget loader are served on
PORT=8080

# Postgres connection (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://wba_admin:wba_dev_password@localhost:5432/wba_platform

# Secret used to sign dashboard login JWTs (change in production)
JWT_SECRET=change-me-in-production

# Groq (primary — set GROQ_API_KEY from https://console.groq.com)
GROQ_API_KEY=
AI_PROVIDER=groq
OPENAI_API_BASE=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.1-8b-instant

# Google Gemini (optional fallback when AI_PROVIDER=auto)
GEMINI_API_KEY=
DEFAULT_MODEL=gemini-2.5-flash-lite

# Seeded admin account (created by `npm run seed`)
ADMIN_EMAIL=admin@acme-corp.com
ADMIN_PASSWORD=admin1234

# Second site account (created by `npm run seed:site`)
SITE_EMAIL=admin@site3000.com
SITE_PASSWORD=admin1234
SITE_NAME=موقع 3000
SITE_KNOWLEDGE_URL=http://localhost:3000

# Public base URL of THIS server, used when printing the embed snippet
PUBLIC_BASE_URL=http://localhost:8080

# Supabase (for live knowledge base — anon/publishable key only, never service_role)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
